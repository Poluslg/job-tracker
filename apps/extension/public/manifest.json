{
  "manifest_version": 3,
  "name": "AI Career Copilot — Job Match & Application Tracker",
  "short_name": "Career Copilot",
  "version": "0.1.0",
  "description": "Analyze how your resume matches any job posting, tailor it honestly, prepare for the interview, and track every application.",
  "minimum_chrome_version": "116",

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "AI Career Copilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },

  "options_page": "src/options/index.html",

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": ["storage", "activeTab", "scripting", "downloads"],

  "optional_host_permissions": ["http://*/*", "https://*/*"],

  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": ["src/onboarding/index.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
