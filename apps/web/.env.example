# ---------------------------------------------------------------------------
# Web dashboard environment
#
# Copy to apps/web/.env.local and fill in. Nothing here is required to run the
# app locally: without Supabase the dashboard falls back to a JSON store in
# .data/db.json and a fixed local identity (development only).
# ---------------------------------------------------------------------------

# Supabase project URL and publishable (anon) key.
# Project Settings -> API. Both are safe to expose to the browser; access is
# constrained by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# It bypasses row-level security and is used for exactly two things:
#   1. reading/writing the ai_credentials table (which denies all client roles)
#   2. deleting an account
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used to build the OAuth redirect URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
