datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        String   @id @db.Uuid
  email     String
  name      String   @default("")
  avatarUrl String   @default("") @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("profiles")
}

model Resume {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  label     String   @default("My Resume")
  isDefault Boolean  @default(false) @map("is_default")
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, updatedAt(sort: Desc)])
  @@map("resumes")
}

model ResumeVersion {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  resumeId  String   @map("resume_id")
  jobId     String?  @map("job_id")
  name      String
  kind      String   @default("manual")
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_versions")
}

model Job {
  id          String   @id
  userId      String   @map("user_id") @db.Uuid
  fingerprint String
  title       String   @default("")
  company     String   @default("")
  url         String   @default("")
  data        Json
  capturedAt  DateTime @default(now()) @map("captured_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, fingerprint])
  @@index([userId, capturedAt(sort: Desc)])
  @@map("jobs")
}

model Analysis {
  id           String   @id
  userId       String   @map("user_id") @db.Uuid
  jobId        String   @map("job_id")
  resumeId     String   @map("resume_id")
  overallScore Int      @default(0) @map("overall_score")
  mode         String   @default("local")
  data         Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, jobId, createdAt(sort: Desc)])
  @@map("analyses")
}

model Application {
  id           String    @id
  userId       String    @map("user_id") @db.Uuid
  jobId        String    @map("job_id")
  status       String    @default("saved")
  company      String    @default("")
  title        String    @default("")
  matchScore   Int?      @map("match_score")
  discoveredAt DateTime  @default(now()) @map("discovered_at") @db.Timestamptz
  appliedAt    DateTime? @map("applied_at") @db.Timestamptz
  data         Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, jobId])
  @@index([userId, discoveredAt(sort: Desc)])
  @@index([userId, status])
  @@map("applications")
}

model CoverLetter {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@map("cover_letters")
}

model InterviewPrep {
  id            String   @id
  userId        String   @map("user_id") @db.Uuid
  jobId         String   @map("job_id")
  applicationId String?  @map("application_id")
  data          Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@map("interview_preps")
}

model UserSettings {
  userId    String   @id @map("user_id") @db.Uuid
  data      Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_settings")
}

model AiCredential {
  userId    String   @id @map("user_id") @db.Uuid
  provider  String   @default("openai")
  apiKey    String   @default("") @map("api_key")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ai_credentials")
}
