{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@job-ai/types": ["../../packages/types/src/index.ts"],
      "@job-ai/core": ["../../packages/core/src/index.ts"],
      "@job-ai/ai": ["../../packages/ai/src/index.ts"],
      "@job-ai/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
